 #include "core.h"
 
+template <typename T>
+void ReadData(const std::string& file_path,
+              std::vector<std::vector<T>>& results,
+              uint32_t& num,
+              uint32_t& dim);
+
+template <typename T>
+void ReadDataHeader(const std::string& file_path, uint32_t& num, uint32_t& dim) {
+    std::ifstream in(file_path, std::ios::binary);
+    if (!in.is_open()) {
+        throw std::runtime_error("cannot open data file: " + file_path);
+    }
+    in.seekg(0, std::ios::end);
+    const size_t file_size = static_cast<size_t>(in.tellg());
+    uint32_t first = 0;
+    uint32_t second = 0;
+    in.seekg(0, std::ios::beg);
+    in.read(reinterpret_cast<char*>(&first), sizeof(first));
+    in.read(reinterpret_cast<char*>(&second), sizeof(second));
+    const size_t binary_size = 8ULL + static_cast<size_t>(first) * second * sizeof(T);
+    if (first > 0 && second > 0 && binary_size == file_size) {
+        num = first;
+        dim = second;
+        return;
+    }
+    dim = first;
+    const size_t row_size = (static_cast<size_t>(dim) + 1) * sizeof(T);
+    if (dim == 0 || row_size == 0 || file_size % row_size != 0) {
+        throw std::runtime_error("unsupported or truncated vector file: " + file_path);
+    }
+    num = static_cast<uint32_t>(file_size / row_size);
+}
+
+void ReadGroundTruth(const std::string& file_path,
+                     std::vector<std::vector<uint32_t>>& results,
+                     uint32_t& num,
+                     uint32_t& dim) {
+    std::ifstream in(file_path, std::ios::binary);
+    if (!in.is_open()) {
+        throw std::runtime_error("cannot open ground-truth file: " + file_path);
+    }
+    in.seekg(0, std::ios::end);
+    const size_t file_size = static_cast<size_t>(in.tellg());
+    uint32_t rows = 0;
+    uint32_t columns = 0;
+    in.seekg(0, std::ios::beg);
+    in.read(reinterpret_cast<char*>(&rows), sizeof(rows));
+    in.read(reinterpret_cast<char*>(&columns), sizeof(columns));
+    const size_t ids_only = 8ULL + static_cast<size_t>(rows) * columns * sizeof(uint32_t);
+    const size_t ids_and_distances =
+        8ULL + static_cast<size_t>(rows) * columns * (sizeof(uint32_t) + sizeof(float));
+    if (rows > 0 && columns > 0 && (file_size == ids_only || file_size == ids_and_distances)) {
+        num = rows;
+        dim = columns;
+        results.assign(num, std::vector<uint32_t>(dim));
+        for (auto& row : results) {
+            in.read(reinterpret_cast<char*>(row.data()), dim * sizeof(uint32_t));
+        }
+        return;
+    }
+    in.close();
+    ReadData(file_path, results, num, dim);
+}

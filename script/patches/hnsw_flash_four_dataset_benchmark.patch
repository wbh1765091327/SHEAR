diff -ruN '--exclude=build' '--exclude=bin' base/benchmark_main.cc work/benchmark_main.cc
--- base/benchmark_main.cc	1970-01-01 08:00:00.000000000 +0800
+++ work/benchmark_main.cc	2026-07-25 23:49:20.650878631 +0800
@@ -0,0 +1,112 @@
+#include "third_party/eigen/Eigen/Dense"
+#include <omp.h>
+#include "include/benchmark/flat_binary.h"
+#include "include/benchmark/flash_benchmark.h"
+
+#include <filesystem>
+#include <fstream>
+
+namespace {
+
+std::string required(const std::map<std::string, std::string>& args, const std::string& name) {
+    auto it = args.find(name);
+    if (it == args.end() || it->second.empty()) {
+        throw std::runtime_error("missing required option --" + name);
+    }
+    return it->second;
+}
+
+void write_metric(const std::string& path, const std::map<std::string, std::string>& values) {
+    std::filesystem::create_directories(std::filesystem::path(path).parent_path());
+    std::ofstream out(path);
+    out << "field\tvalue\n";
+    for (const auto& [key, value] : values) {
+        out << key << '\t' << value << '\n';
+    }
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    try {
+        if (argc < 2) {
+            throw std::runtime_error("usage: hnsw_flash_benchmark <build|validate|search> [options]");
+        }
+        const std::string mode = argv[1];
+        std::map<std::string, std::string> args;
+        for (int i = 2; i < argc; ++i) {
+            const std::string key = argv[i];
+            if (key.rfind("--", 0) != 0 || i + 1 >= argc) {
+                throw std::runtime_error("options must be --name value pairs");
+            }
+            args[key.substr(2)] = argv[++i];
+        }
+        const std::string base = required(args, "base");
+        const std::string codebook = required(args, "codebook");
+        const std::string index = required(args, "index");
+        const std::string metrics = required(args, "metrics");
+        if (args.count("threads")) {
+            NUM_THREADS = std::stoi(args["threads"]);
+        }
+
+        const auto started = std::chrono::steady_clock::now();
+        if (mode == "build") {
+            uint32_t rows = 0;
+            uint32_t dim = 0;
+            ReadDataHeader<float>(base, rows, dim);
+            setenv("HNSW_FLASH_BUILD_ONLY", "1", 1);
+            benchmark::FlashBenchmark strategy(base, "", codebook, index);
+            strategy.solve();
+            const auto ended = std::chrono::steady_clock::now();
+            write_metric(metrics, {
+                {"mode", mode},
+                {"rows", std::to_string(rows)},
+                {"dim", std::to_string(dim)},
+                {"seed", args.count("seed") ? args["seed"] : "42"},
+                {"internal_e2e_seconds", std::to_string(std::chrono::duration<double>(ended - started).count())},
+            });
+        } else if (mode == "validate") {
+            uint32_t rows = 0;
+            uint32_t dim = 0;
+            ReadDataHeader<float>(base, rows, dim);
+            if (args.count("expected-rows") && rows != std::stoul(args["expected-rows"])) {
+                throw std::runtime_error("base row count does not match --expected-rows");
+            }
+            if (!std::filesystem::is_regular_file(index) || !std::filesystem::is_regular_file(codebook)) {
+                throw std::runtime_error("index or codebook artifact is missing");
+            }
+            write_metric(metrics, {
+                {"mode", mode},
+                {"rows", std::to_string(rows)},
+                {"dim", std::to_string(dim)},
+                {"index_bytes", std::to_string(std::filesystem::file_size(index))},
+                {"codebook_bytes", std::to_string(std::filesystem::file_size(codebook))},
+            });
+        } else if (mode == "search") {
+            const std::string query = required(args, "query");
+            const std::string ground_truth = required(args, "ground-truth");
+            const std::string output = required(args, "output");
+            const std::string ef = required(args, "ef-search");
+            setenv("HNSW_FLASH_SEARCH_ONLY", "1", 1);
+            setenv("HNSW_FLASH_EF_SEARCH", ef.c_str(), 1);
+            benchmark::FlashBenchmark strategy(base, query, codebook, index);
+            strategy.solve();
+            strategy.save_knn(output);
+            const double recall = strategy.recall_at_k(ground_truth);
+            const auto ended = std::chrono::steady_clock::now();
+            write_metric(metrics, {
+                {"mode", mode},
+                {"ef_search", ef},
+                {"recall_at_10", std::to_string(recall)},
+                {"internal_e2e_seconds", std::to_string(std::chrono::duration<double>(ended - started).count())},
+            });
+            std::cout << "METRIC recall_at_10 " << recall << '\n';
+        } else {
+            throw std::runtime_error("unknown mode: " + mode);
+        }
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << "ERROR: " << error.what() << '\n';
+        return 2;
+    }
+}
